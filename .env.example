# Runtime
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_DEMO_MODE=false

# PostgreSQL / Prisma
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_password
POSTGRES_DB=ecommerce_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ecommerce:ecommerce_password@localhost:5432/ecommerce_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-me-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-me-with-a-strong-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security / CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Stripe
PAYMENTS_FAKE_MODE=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd

# Razorpay
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-me-with-razorpay-webhook-secret

# Adminer
ADMINER_PORT=8080
